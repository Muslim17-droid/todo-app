@startuml
left to right direction

actor Пользователь as User
actor "Таймер/Система" as Timer

rectangle "Список дел" {
  usecase "Добавить дело" as UC1
  usecase "Просмотреть список дел" as UC2
  usecase "Отметить дело выполненным" as UC3
  usecase "Удалить дело" as UC4
  usecase "Сохранить данные" as UC5
  usecase "Напомнить о просроченных делах" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC1 ..> UC5 : <<include>>
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>

UC3 ..> UC2 : <<extend>>

Timer --> UC6
UC6 ..> UC2 : <<include>>
@enduml